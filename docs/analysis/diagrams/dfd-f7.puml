@startuml dfd-f7
' [TV2] DFD level 1 of F7 "Quản lý khách hàng thân thiết".
' Notation: rectangle = external entity, ellipse (usecase) = process, database = data store.
left to right direction
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #333333
}

rectangle "Khách hàng" as KH
rectangle "Quản trị viên" as ADM
rectangle "F6.2 Trả phòng\n(TV2)" as F62
rectangle "F3.2 Xử lý ticket\n(TV1)" as F32

usecase "7.1\nCập nhật danh mục\nquà tặng" as P71
usecase "7.2\nTheo dõi sổ điểm\nvà đổi quà" as P72

database "D1 Khách hàng" as D1
database "D2 Sổ điểm" as D2
database "D3 Quà tặng" as D3
database "D4 Lượt đổi quà" as D4

ADM --> P71 : thông tin quà
P71 --> D3 : quà mới / quà đã sửa
D3 --> P71 : quà hiện có

KH --> P72 : yêu cầu xem điểm,\nyêu cầu đổi quà / hủy đổi
P72 --> KH : sổ điểm, số dư,\nphiếu đổi quà, thông báo từ chối
D1 --> P72 : hạng khách
D2 --> P72 : các giao dịch điểm
D3 --> P72 : điểm quy đổi, hạng tối thiểu,\nsố lượng
P72 --> D4 : lượt đổi (điểm chốt) / trạng thái hủy
P72 --> D2 : dòng −điểm đổi quà / +điểm hoàn
P72 --> D3 : số lượng −1 / +1

F62 --> D2 : dòng +điểm lưu trú
F62 --> D1 : hạng mới
F32 --> D2 : dòng +điểm thiện chí\n(ticket đã đóng, Q12)
@enduml
